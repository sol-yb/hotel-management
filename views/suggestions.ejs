<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Suggestions - Solomon YT Resort</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <div class="logo"><span>🏨</span>Solomon YT Resort</div>
    <nav>
      <a href="/">Home</a>
      <a href="/rooms">Rooms</a>
      <a href="/food-menu">Menu</a>
      <a href="/shop">Shop</a>
      <a href="/suggestions">Suggestions</a>
      <% if (user) { %>
      <a href="/dashboard">Dashboard</a>
      <a href="/logout">Logout</a>
      <% } else { %>
      <a href="/login">Login</a>
      <a href="/register">Register</a>
      <% } %>
    </nav>
  </header>

  <section class="hero">
    <h1>Guest Suggestions & Feedback</h1>
    <p>We value your opinions! Share your suggestions, feedback, or ideas to help us improve your experience.</p>
  </section>

  <section class="form-card">
    <h2>Submit Your Suggestion</h2>
    <form action="/suggestions" method="POST">
      <div class="form-group">
        <label for="suggestion">Your Suggestion</label>
        <textarea id="suggestion" name="suggestion" rows="5" placeholder="Please share your thoughts, suggestions, or feedback about our hotel..." required></textarea>
      </div>
      <button type="submit" class="button">Submit Suggestion</button>
    </form>
  </section>

  <div class="section-title">
    <h2>All Guest Suggestions</h2>
  </div>

  <div class="suggestions-list">
    <% if (suggestions.length === 0) { %>
      <p class="no-suggestions">No suggestions yet. Be the first to share your thoughts!</p>
    <% } else { %>
      <% suggestions.forEach(suggestion => { %>
        <div class="suggestion-card">
          <div class="suggestion-header">
            <strong><%= suggestion.name %></strong>
            <span class="suggestion-date"><%= new Date(suggestion.created_at).toLocaleDateString() %></span>
          </div>
          <div class="suggestion-content">
            <%= suggestion.suggestion %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

</body>
</html>