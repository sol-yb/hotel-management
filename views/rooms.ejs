<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rooms - Solomon YT Resort</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <div class="logo"><span>🏨</span>Solomon YT Resort</div>
    <nav>
      <a href="/">Home</a>
      <a href="/food-menu">food</a>
      <% if (user) { %>
      <a href="/dashboard">Dashboard</a>
      <a href="/suggestions">Suggestions</a>
      <a href="/logout">Logout</a>
      <% } else { %>
      <a href="/login">Login</a>
      <% } %>
    </nav>
  </header>
  <section class="section-title">
    <h2>Available rooms</h2>
    <% if (user) { %>
    <a class="button-small" href="/dashboard">My bookings</a>
    <% } else { %>
    <a class="button-small" href="/login">Login to book</a>
    <% } %>
  </section>
  <section class="form-card">
    <h3>Filter Rooms</h3>
    <form method="GET" action="/rooms" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: end;">
      <div>
        <label for="type">Room Type</label>
        <select id="type" name="type">
          <option value="">All Types</option>
          <option value="Deluxe">Deluxe</option>
          <option value="Standard">Standard</option>
          <option value="Suite">Suite</option>
          <option value="Executive">Executive</option>
          <option value="Family">Family</option>
          <option value="Penthouse">Penthouse</option>
          <option value="Business">Business</option>
          <option value="Romantic">Romantic</option>
          <option value="Budget">Budget</option>
        </select>
      </div>
      <div>
        <label for="min_price">Min Price</label>
        <input id="min_price" name="min_price" type="number" step="0.01" placeholder="0" />
      </div>
      <div>
        <label for="max_price">Max Price</label>
        <input id="max_price" name="max_price" type="number" step="0.01" placeholder="500" />
      </div>
      <div>
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="">All Status</option>
          <option value="Available">Available</option>
          <option value="Occupied">Occupied</option>
          <option value="Maintenance">Maintenance</option>
        </select>
      </div>
      <button class="button" type="submit">Filter</button>
      <a href="/rooms" class="button button-secondary">Clear Filters</a>
    </form>
  </section>
  <div class="cards-grid">
    <% rooms.forEach(room => { %>
    <div class="card">
      <img src="<%= room.image_url || 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=250&q=80' %>" alt="<%= room.type %> room" />
      <div class="card-content">
        <h3>Room <%= room.room_number %> - <%= room.type %></h3>
        <p><%= room.description || 'A beautiful room designed for guest comfort.' %></p>
      </div>
      <div class="card-footer">
        <span>$<%= room.price.toFixed(2) %>/night</span>
        <a class="button button-secondary" href="/book-room/<%= room.id %>">Book now</a>
      </div>
    </div>
    <% }) %>
  </div>
  <footer>
    <p>Book your room, track your stay, and enjoy hotel services.</p>
  </footer>
</body>
</html>
