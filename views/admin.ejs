<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard - Solomon YT Resort Manager</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <% const shopItems = typeof shopItems !== 'undefined' ? shopItems : []; %>
  <header>
    <div class="logo"><span>🏨</span>Solomon YT Resort Manager</div>
    <nav>
      <a href="/">Home</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>

  <section class="hero">
    <h1>Admin Dashboard</h1>
    <p>Manage rooms, bookings, food items, and view guest activity history.</p>
  </section>

  <!-- ADD ROOM FORM -->
  <div class="form-card">
    <h2>Add room</h2>
    <form method="POST" action="/admin/rooms" enctype="multipart/form-data">
      <label>Room number</label>
      <input name="room_number" required />
      <label>Type</label>
      <input name="type" required />
      <label>Price</label>
      <input name="price" type="number" step="0.01" required />
      <label>Status</label>
      <select name="status">
        <option>Available</option>
        <option>Occupied</option>
        <option>Maintenance</option>
      </select>
      <label>Description</label>
      <textarea name="description"></textarea>
      <label>Image</label>
      <input name="image" type="file" accept="image/*" />
      <button class="button" type="submit">Add room</button>
    </form>
  </div>

  <!-- ROOM MANAGEMENT TABLE -->
  <div class="table-container">
    <h2>Room Management</h2>
    <table>
      <thead><tr><th>Room</th><th>Type</th><th>Price</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% rooms.forEach(room => { %>
        <tr>
          <td><%= room.room_number %></td>
          <td><%= room.type %></td>
          <td>$<%= room.price.toFixed(2) %></td>
          <td><%= room.status %></td>
          <td>
            <!-- Data attributes prevent IDE syntax errors -->
            <button 
              class="button button-small" 
              data-id="<%= room.id %>"
              data-room-number="<%= room.room_number %>"
              data-type="<%= room.type %>"
              data-price="<%= room.price %>"
              data-status="<%= room.status %>"
              data-description="<%= room.description || '' %>"
              data-image-url="<%= room.image_url || '' %>"
              onclick="openEditRoom(this)">
              Edit
            </button>
            <form method="POST" action="/admin/rooms/<%= room.id %>/delete" style="display:inline;">
              <button class="button button-secondary" type="submit">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- FOOD MANAGEMENT -->
  <div class="form-card">
    <h2>Add food item</h2>
    <form method="POST" action="/admin/food" enctype="multipart/form-data">
      <label>Name</label>
      <input name="name" required />
      <label>Category</label>
      <input name="category" required />
      <label>Price</label>
      <input name="price" type="number" step="0.01" required />
      <label>Description</label>
      <textarea name="description"></textarea>
      <label>Image</label>
      <input name="image" type="file" accept="image/*" />
      <button class="button" type="submit">Add item</button>
    </form>
  </div>

  <div class="table-container">
    <h2>Food & Service Menu</h2>
    <table>
      <thead><tr><th>Name</th><th>Category</th><th>Price</th><th></th></tr></thead>
      <tbody>
        <% foods.forEach(item => { %>
        <tr>
          <td><%= item.name %></td>
          <td><%= item.category %></td>
          <td>$<%= item.price.toFixed(2) %></td>
          <td>
            <button 
              class="button button-small"
              data-id="<%= item.id %>"
              data-name="<%= item.name %>"
              data-category="<%= item.category %>"
              data-price="<%= item.price %>"
              data-description="<%= item.description || '' %>"
              data-image-url="<%= item.image_url || '' %>"
              onclick="openEditFood(this)">
              Edit
            </button>
            <form method="POST" action="/admin/food/<%= item.id %>/delete" style="display:inline;">
              <button class="button button-secondary" type="submit">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- SHOP MANAGEMENT -->
  <div class="form-card">
    <h2>Add shop item</h2>
    <form method="POST" action="/admin/shop" enctype="multipart/form-data">
      <label>Name</label>
      <input name="name" required />
      <label>Category</label>
      <input name="category" required />
      <label>Price</label>
      <input name="price" type="number" step="0.01" required />
      <label>Description</label>
      <textarea name="description"></textarea>
      <label>Image</label>
      <input name="image" type="file" accept="image/*" />
      <button class="button" type="submit">Add item</button>
    </form>
  </div>

  <div class="table-container">
    <h2>Shop Items Management</h2>
    <table>
      <thead><tr><th>Name</th><th>Category</th><th>Price</th><th></th></tr></thead>
      <tbody>
        <% shopItems.forEach(item => { %>
        <tr>
          <td><%= item.name %></td>
          <td><%= item.category %></td>
          <td>$<%= item.price.toFixed(2) %></td>
          <td>
            <button 
              class="button button-small"
              data-id="<%= item.id %>"
              data-name="<%= item.name %>"
              data-category="<%= item.category %>"
              data-price="<%= item.price %>"
              data-description="<%= item.description || '' %>"
              data-image-url="<%= item.image_url || '' %>"
              onclick="openEditShop(this)">
              Edit
            </button>
            <form method="POST" action="/admin/shop/<%= item.id %>/delete" style="display:inline;">
              <button class="button button-secondary" type="submit">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- BOOKING MANAGEMENT -->
  <div class="table-container">
    <h2>Booking Management</h2>
    <table>
      <thead><tr><th>Guest</th><th>Room</th><th>Dates</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <% bookings.forEach(booking => { %>
        <tr>
          <td><a href="/admin/guest/<%= booking.user_id %>"><%= booking.guest_name %></a></td>
          <td><%= booking.room_number %></td>
          <td><%= booking.check_in %> → <%= booking.check_out %></td>
          <td><%= booking.status %></td>
          <td>
            <form method="POST" action="/admin/bookings/<%= booking.id %>/status">
              <select name="status">
                <option <%= booking.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                <option <%= booking.status === 'Confirmed' ? 'selected' : '' %>>Confirmed</option>
                <option <%= booking.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
              </select>
              <button class="button" type="submit">Update</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>it 
    </table>
  </div>

  <footer>
    <p>Guest activity, room assignments, and menu management are all in one place.</p>
  </footer>

  <!-- MODALS -->
  <div id="editRoomModal" class="modal" style="display: none;">
    <div class="modal-content">
      <span class="close" onclick="closeModal('editRoomModal')">&times;</span>
      <h2>Edit Room</h2>
      <form id="editRoomForm" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="current_image" id="roomCurrentImage" />
        <label>Room number</label>
        <input id="roomNumber" name="room_number" required />
        <label>Type</label>
        <input id="roomType" name="type" required />
        <label>Price</label>
        <input id="roomPrice" name="price" type="number" step="0.01" required />
        <label>Status</label>
        <select id="roomStatus" name="status">
          <option>Available</option>
          <option>Occupied</option>
          <option>Maintenance</option>
        </select>
        <label>Description</label>
        <textarea id="roomDescription" name="description"></textarea>
        <label>Image (leave empty to keep current)</label>
        <input name="image" type="file" accept="image/*" />
        <button class="button" type="submit">Update room</button>
      </form>
    </div>
  </div>

  <div id="editFoodModal" class="modal" style="display: none;">
    <div class="modal-content">
      <span class="close" onclick="closeModal('editFoodModal')">&times;</span>
      <h2>Edit Food Item</h2>
      <form id="editFoodForm" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="current_image" id="foodCurrentImage" />
        <label>Name</label>
        <input id="foodName" name="name" required />
        <label>Category</label>
        <input id="foodCategory" name="category" required />
        <label>Price</label>
        <input id="foodPrice" name="price" type="number" step="0.01" required />
        <label>Description</label>
        <textarea id="foodDescription" name="description"></textarea>
        <label>Image (leave empty to keep current)</label>
        <input name="image" type="file" accept="image/*" />
        <button class="button" type="submit">Update item</button>
      </form>
    </div>
  </div>

  <div id="editShopModal" class="modal" style="display: none;">
    <div class="modal-content">
      <span class="close" onclick="closeModal('editShopModal')">&times;</span>
      <h2>Edit Shop Item</h2>
      <form id="editShopForm" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="current_image" id="shopCurrentImage" />
        <label>Name</label>
        <input id="shopName" name="name" required />
        <label>Category</label>
        <input id="shopCategory" name="category" required />
        <label>Price</label>
        <input id="shopPrice" name="price" type="number" step="0.01" required />
        <label>Description</label>
        <textarea id="shopDescription" name="description"></textarea>
        <label>Image (leave empty to keep current)</label>
        <input name="image" type="file" accept="image/*" />
        <button class="button" type="submit">Update item</button>
      </form>
    </div>
  </div>

  <script>
    // ROOM EDIT HANDLER
    function openEditRoom(btn) {
      const id = btn.getAttribute('data-id');
      document.getElementById('editRoomForm').action = `/admin/rooms/${id}/update`;
      document.getElementById('roomNumber').value = btn.getAttribute('data-room-number');
      document.getElementById('roomType').value = btn.getAttribute('data-type');
      document.getElementById('roomPrice').value = btn.getAttribute('data-price');
      document.getElementById('roomStatus').value = btn.getAttribute('data-status');
      document.getElementById('roomDescription').value = btn.getAttribute('data-description');
      document.getElementById('roomCurrentImage').value = btn.getAttribute('data-image-url');
      document.getElementById('editRoomModal').style.display = 'block';
    }

    // FOOD EDIT HANDLER
    function openEditFood(btn) {
      const id = btn.getAttribute('data-id');
      document.getElementById('editFoodForm').action = `/admin/food/${id}/update`;
      document.getElementById('foodName').value = btn.getAttribute('data-name');
      document.getElementById('foodCategory').value = btn.getAttribute('data-category');
      document.getElementById('foodPrice').value = btn.getAttribute('data-price');
      document.getElementById('foodDescription').value = btn.getAttribute('data-description');
      document.getElementById('foodCurrentImage').value = btn.getAttribute('data-image-url');
      document.getElementById('editFoodModal').style.display = 'block';
    }

    function openEditShop(btn) {
      const id = btn.getAttribute('data-id');
      document.getElementById('editShopForm').action = `/admin/shop/${id}/update`;
      document.getElementById('shopName').value = btn.getAttribute('data-name');
      document.getElementById('shopCategory').value = btn.getAttribute('data-category');
      document.getElementById('shopPrice').value = btn.getAttribute('data-price');
      document.getElementById('shopDescription').value = btn.getAttribute('data-description');
      document.getElementById('shopCurrentImage').value = btn.getAttribute('data-image-url');
      document.getElementById('editShopModal').style.display = 'block';
    }

    function closeModal(modalId) {
      document.getElementById(modalId).style.display = 'none';
    }

    window.onclick = function(event) {
      if (event.target.classList.contains('modal')) {
        event.target.style.display = 'none';
      }
    }
  </script>
</body>
</html>