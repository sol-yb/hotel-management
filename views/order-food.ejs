<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Food - Solomon YT Resort</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <div class="logo"><span>🏨</span>Solomon YT Resort</div>
    <nav>
      <a href="/">Home</a>
      <a href="/rooms">Rooms</a>
      <a href="/food-menu">Menu</a>
      <a href="/shop">Shop</a>
      <a href="/dashboard">Dashboard</a>
      <a href="/suggestions">Suggestions</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>
  <section class="form-card">
    <h2>Order Food & Services</h2>
    <% if (error) { %>
    <div class="alert"><%= error %></div>
    <% } %>
    <form id="orderForm" method="POST" action="/order-food">
      <label for="delivery">Delivery method</label>
      <select id="delivery" name="delivery">
        <option>Room delivery</option>
        <option>Restaurant pickup</option>
      </select>
      <label for="room_id">Room number (optional)</label>
      <input id="room_id" name="room_id" type="text" placeholder="Room number for delivery" />
      <label for="guest_message">Special message for chef or your feelings</label>
      <textarea id="guest_message" name="guest_message" placeholder="Any special requests, dietary notes, or message for the chef..."></textarea>
      <input type="hidden" id="cartItems" name="items" value="" />
      <button class="button" type="submit">Place Order</button>
    </form>
  </section>

  <div class="section-title">
    <h2>Menu</h2>
  </div>
  <div class="cards-grid">
    <% foods.forEach(item => { %>
    <div class="card">
      <img src="<%= item.image_url || 'https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?auto=format&fit=crop&w=250&q=80' %>" alt="<%= item.name %>" />
      <div class="card-content">
        <h3><%= item.name %></h3>
        <p><strong><%= item.category %></strong> • $<%= item.price.toFixed(2) %></p>
        <p><%= item.description %></p>
      </div>
      <div class="card-footer">
        <button class="button button-secondary add-to-cart" data-id="<%= item.id %>" data-name="<%= item.name %>" data-price="<%= item.price %>">Add to Cart</button>
      </div>
    </div>
    <% }) %>
  </div>

  <section class="form-card" id="cartSection" style="display: none;">
    <h2>Your Cart</h2>
    <div id="cartItemsList"></div>
    <div id="cartTotal" style="font-weight: bold; margin-top: 1rem;"></div>
  </section>

  <script>
    let cart = {};

    function updateCart() {
      const cartItemsList = document.getElementById('cartItemsList');
      const cartTotal = document.getElementById('cartTotal');
      const cartSection = document.getElementById('cartSection');
      const cartItemsInput = document.getElementById('cartItems');

      cartItemsList.innerHTML = '';
      let total = 0;
      let itemsValue = [];

      for (const id in cart) {
        const item = cart[id];
        const itemTotal = item.price * item.quantity;
        total += itemTotal;
        itemsValue.push(`${id}:${item.quantity}`);

        const itemDiv = document.createElement('div');
        itemDiv.style.display = 'flex';
        itemDiv.style.justifyContent = 'space-between';
        itemDiv.style.alignItems = 'center';
        itemDiv.style.marginBottom = '0.5rem';
        itemDiv.innerHTML = `
          <span>${item.name} x${item.quantity} - $${itemTotal.toFixed(2)}</span>
          <button class="button button-secondary" onclick="removeFromCart('${id}')">Remove</button>
        `;
        cartItemsList.appendChild(itemDiv);
      }

      cartTotal.textContent = `Total: $${total.toFixed(2)}`;
      cartItemsInput.value = itemsValue.join(',');
      cartSection.style.display = Object.keys(cart).length > 0 ? 'block' : 'none';
    }

    function addToCart(id, name, price) {
      if (cart[id]) {
        cart[id].quantity += 1;
      } else {
        cart[id] = { name, price: parseFloat(price), quantity: 1 };
      }
      updateCart();
    }

    function removeFromCart(id) {
      delete cart[id];
      updateCart();
    }

    document.querySelectorAll('.add-to-cart').forEach(button => {
      button.addEventListener('click', () => {
        const id = button.dataset.id;
        const name = button.dataset.name;
        const price = button.dataset.price;
        addToCart(id, name, price);
      });
    });

    document.getElementById('orderForm').addEventListener('submit', (e) => {
      if (Object.keys(cart).length === 0) {
        e.preventDefault();
        alert('Please add items to your cart before placing an order.');
      }
    });
  </script>
</body>
</html>
